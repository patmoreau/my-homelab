# Container runtime UID/GID for files written to app-managed data folders.
PUID={{ nas_puid }}
PGID={{ nas_pgid }}

# Database credentials
POSTGRES_USER=bookorbit
POSTGRES_PASSWORD={{ bookorbit_postgres_password }}
POSTGRES_DB=bookorbit

# App secrets
JWT_SECRET={{ bookorbit_jwt_token }}
SETUP_BOOTSTRAP_TOKEN={{ bookorbit_setup_bootstrap_token }}
