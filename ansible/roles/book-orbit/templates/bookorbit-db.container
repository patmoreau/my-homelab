[Unit]
Description=BookOrbit PostgreSQL

[Container]
ContainerName=bookorbit-db
Image=pgvector/pgvector:pg16
# Owns the shared netns; publishes the app's web port (3001 -> 3000 inside the netns).
# Postgres listens on 5432, reached by the app over 127.0.0.1 (no Quadlet .pod on 4.9).
IP=10.88.0.244
PublishPort=3001:3000
Volume=/data/bookorbit/postgres:/var/lib/postgresql/data
EnvironmentFile=/opt/docker/bookorbit/bookorbit.env
HealthCmd=pg_isready -U bookorbit -d bookorbit

[Service]
Restart=always
# bookorbit-app joins this container's netns, so podman refuses to replace this container
# while the app's container object still exists — the unit then crash-loops on
# "has dependent containers which must be removed before it: bookorbit-app". systemd's
# ordering does not help: after a host reboot both container objects are already there when
# this unit first runs. Remove the dependent up front; BindsTo=/After= on bookorbit.service
# brings the app back once this is up. Leading '-' so a missing container is not an error.
ExecStartPre=-/usr/bin/podman rm -f bookorbit-app

[Install]
WantedBy=default.target
