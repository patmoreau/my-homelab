NODE_ENV=production
PORT=3000
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_USER=bookorbit
POSTGRES_PASSWORD={{ bookorbit_postgres_password }}
POSTGRES_DB=bookorbit
JWT_SECRET={{ bookorbit_jwt_token }}
SETUP_BOOTSTRAP_TOKEN={{ bookorbit_setup_bootstrap_token }}
{# Without this BookOrbit refuses to save indexer or download-client credentials rather
   than storing them in the clear, so the Prowlarr and Transmission rows cannot be created. #}
BOOK_REQUEST_ENCRYPTION_KEY={{ bookorbit_book_request_encryption_key }}
APP_URL=https://books.moreaulab.ca
PUID={{ nas_puid }}
PGID={{ nas_pgid }}
NODE_MAX_OLD_SPACE_SIZE=2048
PGDATA=/var/lib/postgresql/data/pgdata
