[Unit]
Description=cAdvisor container metrics

[Container]
ContainerName=cadvisor
Image=gcr.io/cadvisor/cadvisor:v0.55.1
PublishPort=9338:8080
# Reads container metrics from cgroups (works for Podman). The Docker-specific
# /var/lib/docker mount is dropped (limited image-name labels), and /var/run is NOT
# bind-mounted read-only because Podman needs to write /run/.containerenv. The Podman
# API socket is mounted for container metadata instead.
Volume=/:/rootfs:ro
Volume=/sys:/sys:ro
Volume=/dev/disk/:/dev/disk:ro
Volume=/run/podman/podman.sock:/var/run/docker.sock:ro

[Service]
Restart=always

[Install]
WantedBy=default.target
