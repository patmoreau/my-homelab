services:
  mariadb:
    image: lscr.io/linuxserver/mariadb:latest
    container_name: essere_db
    restart: unless-stopped
    expose:
      - 3306
    environment:
      - PUID=${PUID}
      - PGID=${PGID}
      - TZ=${TZ}
      - MYSQL_ROOT_PASSWORD=${MYSQL_ROOT_PASSWORD}
      - MYSQL_DATABASE=${MYSQL_DATABASE}
      - MYSQL_USER=${MYSQL_USER}
      - MYSQL_PASSWORD=${MYSQL_PASSWORD}
    volumes:
      - /data/mariadb:/config
    networks:
      - wordpress_internal
    healthcheck:
      test: ["CMD", "mysqladmin", "ping", "-h", "localhost", "--silent"]
      interval: 10s
      timeout: 5s
      retries: 5
      start_period: 30s

  nginx:
    image: lscr.io/linuxserver/nginx:latest
    container_name: essere
    restart: unless-stopped
    depends_on:
      mariadb:
        condition: service_healthy
    ports:
      - 80:80
    environment:
      - TZ=${TZ}
    volumes:
      - /data/nginx:/config
      - /data/wordpress:/config/www/
    networks:
      - wordpress_internal
      - wordpress_external

  ghost:
    image: ghost:latest
    container_name: ghost
    restart: always
    ports:
      - "2368:2368"
    environment:
      - url=https://ghost.moreaulab.ca
      - NODE_ENV=production
      - database__client=mysql
      - database__connection__host=ghost_db
      - database__connection__user=${MYSQL_USER}
      - database__connection__password=${MYSQL_PASSWORD}
      - database__connection__database=ghost_db
    volumes:
      - /data/ghost:/var/lib/ghost/content
    depends_on:
      ghost_db:
        condition: service_healthy
    networks:
      - ghost_internal
      - ghost_external

  ghost_db:
    image: lscr.io/linuxserver/mariadb:latest
    container_name: ghost_db
    restart: always
    expose:
      - 3306
    environment:
      - PUID=${PUID}
      - PGID=${PGID}
      - TZ=${TZ}
      - MYSQL_ROOT_PASSWORD=${MYSQL_ROOT_PASSWORD}
      - MYSQL_DATABASE=ghost_db
      - MYSQL_USER=${MYSQL_USER}
      - MYSQL_PASSWORD=${MYSQL_PASSWORD}
    volumes:
      - /data/ghostdb:/config
    networks:
      - ghost_internal
    healthcheck:
      test: ["CMD", "mysqladmin", "ping", "-h", "localhost", "--silent"]
      interval: 10s
      timeout: 5s
      retries: 5
      start_period: 30s

networks:
  wordpress_internal:
    internal: true
  wordpress_external:
    internal: false
  ghost_internal:
    internal: true
  ghost_external:
    internal: false