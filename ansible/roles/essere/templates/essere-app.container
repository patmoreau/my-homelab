[Unit]
Description=Essere App
After=essere-directus.service
BindsTo=essere-db.service

[Container]
ContainerName=essere_app
Image=essere-app:latest
Network=container:essere_postgres
# Locally loaded image (shipped via save/load), so never try to pull it. (--add-host is
# not allowed with --network=container:, and the app reaches directus via its public URL.)
PodmanArgs=--pull=never

[Service]
Restart=always

[Install]
WantedBy=default.target
