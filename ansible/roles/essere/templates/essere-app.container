[Unit]
Description=Essere App
After=essere-directus.service
BindsTo=essere-db.service

[Container]
ContainerName=essere_app
Image={{ essere_registry }}/essere-app:{{ essere_image_tag }}
# Rolling tag pulled from ghcr; `podman auto-update` rolls it when the digest changes.
Label=io.containers.autoupdate=registry
Network=container:essere_postgres

[Service]
Restart=always

[Install]
WantedBy=default.target
