# APPLICATION_URL feeds general.host, which despite the name is a bare HOST, not a URL —
# Filestash builds the frontend's expected origin as scheme + host (https only when
# general.force_ssl is on). A scheme here yields "http://https://docs.moreaulab.ca" and the
# UI refuses to boot, redirecting to that garbage origin.
APPLICATION_URL={{ filestash_domain }}
CANARY=true
# auth.admin is compared with bcrypt.CompareHashAndPassword, and Filestash stores whatever
# ADMIN_PASSWORD contains verbatim — so this must be the HASH, not the plaintext. Go's
# bcrypt rejects htpasswd's $2y$ prefix; the vault value is normalised to $2a$.
# Applied on every start, so a password changed in the admin console is reverted on the
# next restart. Change it in the vault instead.
ADMIN_PASSWORD={{ vault_filestash_admin_password_hash }}
TZ={{ timezone }}
