apiVersion: 1

# Provisioning a policy tree replaces Grafana's built-in default policy, so this
# is the only route: every alert goes to Home Assistant.
policies:
  - orgId: 1
    receiver: Home Assistant
    group_by:
      - alertname
      - instance
    group_wait: 30s
    group_interval: 5m
    repeat_interval: 12h
