apiVersion: 1

groups:
  - orgId: 1
    name: Disk
    folder: Homelab Alerts
    interval: 1m
    rules:
      # Every LXC with a persistent volume mounts it at /data. Those volumes are
      # small and sized per service, so they fill long before the boot disk does
      # — and a full one breaks services quietly (a full monitoring-data made
      # Grafana's SQLite DB fail every write with "database or disk is full").
      - uid: data-volume-usage-high
        title: /data volume above 80%
        condition: C
        for: 15m
        noDataState: NoData
        execErrState: Error
        labels:
          severity: warning
        annotations:
          summary: {% raw %}'/data on {{ $labels.instance }} is over 80% full'{% endraw %}

          description: {% raw %}'{{ $labels.instance }} /data is at {{ printf "%.1f" $values.A.Value }}%. Grow the volume in terraform/persistent-storage/variables.tf or lower the service retention budget so it stays under the volume size.'{% endraw %}

        data:
          - refId: A
            relativeTimeRange:
              from: 600
              to: 0
            datasourceUid: Prometheus
            model:
              refId: A
              instant: true
              editorMode: code
              expr: '100 - (node_filesystem_avail_bytes{mountpoint="/data", fstype="ext4"} / node_filesystem_size_bytes{mountpoint="/data", fstype="ext4"} * 100)'
          - refId: C
            datasourceUid: __expr__
            model:
              refId: C
              type: threshold
              expression: A
              conditions:
                - evaluator:
                    type: gt
                    params:
                      - 80

  - orgId: 1
    name: Availability
    folder: Homelab Alerts
    interval: 1m
    rules:
      # Covers every scrape job at once, which is a different signal from the probe rules
      # below: those watch services answering HTTP, this watches Prometheus being able to
      # collect at all. The pve exporter was unreachable for days without tripping
      # anything, because a dead *exporter* is invisible to a blackbox *probe*.
      #
      # A host going down trips this for its node_exporter and cadvisor together; the
      # notification policy groups by alertname and instance, so that arrives as one
      # batch rather than a storm.
      - uid: scrape-target-down
        title: Prometheus cannot scrape a target
        condition: C
        for: 10m
        noDataState: NoData
        execErrState: Error
        labels:
          severity: warning
        annotations:
          summary: {% raw %}'Prometheus cannot scrape {{ $labels.job }} on {{ $labels.instance }}'{% endraw %}

          description: {% raw %}'The {{ $labels.job }} target {{ $labels.instance }} has been unscrapeable for 10 minutes. The exporter is down, its port is unreachable, or the host is gone. Check Status > Targets in Prometheus for the connection error.'{% endraw %}

        data:
          - refId: A
            relativeTimeRange:
              from: 900
              to: 0
            datasourceUid: Prometheus
            model:
              refId: A
              instant: true
              editorMode: code
              expr: 'up'
          - refId: C
            datasourceUid: __expr__
            model:
              refId: C
              type: threshold
              expression: A
              conditions:
                - evaluator:
                    type: lt
                    params:
                      - 1

      # The blackbox_public job probes the real public URLs, so this fires on anything
      # that breaks the chain for actual visitors — app crash, tunnel down, Traefik
      # misroute, expired cert. The internal 'blackbox' job can stay green through all
      # of those, which is why the alert is scoped to the public job.
      #
      # Blind spot: the prober and the Home Assistant webhook both live on the LAN, so a
      # house-wide outage produces silence, not an alert. The external uptime monitor
      # (see ansible/README.md) is what covers that case.
      - uid: public-site-down
        title: Public site unreachable
        condition: C
        for: 5m
        noDataState: Alerting
        execErrState: Alerting
        labels:
          severity: critical
        annotations:
          summary: {% raw %}'{{ $labels.instance }} is not answering'{% endraw %}

          description: {% raw %}'The blackbox probe of {{ $labels.instance }} has failed for 5 minutes. Check the essere containers on lxc-essere, then cloudflared and traefik on lxc-gateway.'{% endraw %}

        data:
          - refId: A
            relativeTimeRange:
              from: 600
              to: 0
            datasourceUid: Prometheus
            model:
              refId: A
              instant: true
              editorMode: code
              expr: 'probe_success{job="blackbox_public"}'
          - refId: C
            datasourceUid: __expr__
            model:
              refId: C
              type: threshold
              expression: A
              conditions:
                - evaluator:
                    type: lt
                    params:
                      - 1

      # Companion to the rule above, for the internal probes. Those hit container LAN IPs,
      # so this is the "a service died" alert while public-site-down is the "visitors
      # can't reach it" one. Deliberately one rule over the whole job rather than one per
      # service: every target in the blackbox job is covered, including ones added later.
      - uid: service-probe-failing
        title: Service not responding
        condition: C
        for: 5m
        noDataState: NoData
        execErrState: Error
        labels:
          severity: warning
        annotations:
          summary: {% raw %}'{{ $labels.service }} is not responding'{% endraw %}

          description: {% raw %}'The blackbox probe of {{ $labels.service }} ({{ $labels.instance }}) has failed for 5 minutes. Check the container on its LXC host.'{% endraw %}

        data:
          - refId: A
            relativeTimeRange:
              from: 600
              to: 0
            datasourceUid: Prometheus
            model:
              refId: A
              instant: true
              editorMode: code
              expr: 'probe_success{job="blackbox"}'
          - refId: C
            datasourceUid: __expr__
            model:
              refId: C
              type: threshold
              expression: A
              conditions:
                - evaluator:
                    type: lt
                    params:
                      - 1

      # Certs are renewed by Traefik over DNS-01. When that quietly stops working the
      # only symptom is the expiry creeping down, and by the time it lapses every
      # visitor gets a browser warning. 14 days leaves room to fix it by hand.
      #
      # Not filtered by job: this covers the essere.ca certs from blackbox_public and the
      # moreaulab.ca wildcard via the one https target in the blackbox job. Any https
      # target added to either job is picked up with no change here.
      - uid: tls-cert-expiring
        title: TLS certificate expiring within 14 days
        condition: C
        for: 1h
        noDataState: NoData
        execErrState: Error
        labels:
          severity: warning
        annotations:
          summary: {% raw %}'TLS cert for {{ $labels.instance }} expires in under 14 days'{% endraw %}

          description: {% raw %}'{{ $labels.instance }} has {{ printf "%.1f" $values.A.Value }} days of certificate left. Traefik renews via the cloudflare DNS-01 resolver — check its logs on lxc-gateway and that the API token is still valid.'{% endraw %}

        data:
          - refId: A
            relativeTimeRange:
              from: 600
              to: 0
            datasourceUid: Prometheus
            model:
              refId: A
              instant: true
              editorMode: code
              expr: '(probe_ssl_earliest_cert_expiry - time()) / 86400'
          - refId: C
            datasourceUid: __expr__
            model:
              refId: C
              type: threshold
              expression: A
              conditions:
                - evaluator:
                    type: lt
                    params:
                      - 14

  - orgId: 1
    name: Podman
    folder: Homelab Alerts
    interval: 1m
    rules:
      # Podman 4.9 can leak a container's netns when the container is recreated (a Renovate
      # image bump is enough). Because the Quadlet units pin IP=, the replacement reuses the
      # address the corpse still answers ARP for, so the host reaches the dead namespace and
      # every connection to the published port is refused — while the container itself is
      # healthy and serving fine inside its own netns. Traefik returns 502 and nothing in the
      # container's logs explains it. Homepage hit this twice in one day, vaultwarden once.
      #
      # Alerting on the hijack count rather than podman_orphan_veths is deliberate: a leaked
      # veth is inert until it claims an address a live container is using, and several
      # harmless ones exist right now. This metric going above zero means a service is
      # already down. Written by podman-orphan-check via the node_exporter textfile
      # collector — see roles/podman/files/podman-orphan-check.sh.
      - uid: podman-netns-leak-hijack
        title: Container IP hijacked by a leaked Podman netns
        condition: C
        for: 5m
        noDataState: NoData
        execErrState: Error
        labels:
          severity: critical
        annotations:
          summary: {% raw %}'A leaked netns is holding a live container IP on {{ $labels.instance }}'{% endraw %}

          description: {% raw %}'{{ printf "%.0f" $values.A.Value }} container IP(s) on {{ $labels.instance }} resolve to a dead network namespace, so those services refuse connections despite the containers being healthy. podman-orphan-check deletes a leak it has seen twice, so this normally clears itself inside ~10 minutes — still firing after that means the reaper could not remove the veth. Check `journalctl -t podman-orphan-check`, then `ip link delete <orphan veth> && ip neigh flush dev podman0` by hand. See the Static IPs notes in ansible/README.md.'{% endraw %}

        data:
          - refId: A
            relativeTimeRange:
              from: 600
              to: 0
            datasourceUid: Prometheus
            model:
              refId: A
              instant: true
              editorMode: code
              expr: 'podman_arp_hijacked_ips'
          - refId: C
            datasourceUid: __expr__
            model:
              refId: C
              type: threshold
              expression: A
              conditions:
                - evaluator:
                    type: gt
                    params:
                      - 0

  - orgId: 1
    name: Network
    folder: Homelab Alerts
    interval: 1m
    rules:
      # lxc-media's traffic is routed through a VPN by a per-MAC policy on the router, not
      # by anything on the host. The router's kill switch should block traffic when the
      # tunnel drops; this is the backup in case it does not, because then every service on
      # that LXC silently falls back to the home ISP address and keeps running, torrent peer
      # traffic included. vpn-egress-check asks an external service which address the
      # traffic arrives from every 10 minutes, on lxc-media (side=protected) and on
      # lxc-monitoring (side=baseline, outside the VPN policy) — see
      # roles/vpn_egress_check/files/vpn-egress-check.sh.
      #
      # A leak is a protected host leaving on the same address as the baseline. Nothing is
      # hardcoded, so VPN exit rotations or a new home IP need no change here. The [15m]
      # window bridges node_exporter scrape gaps (up to 11m seen on lxc-media) and the two
      # hosts checking at different moments. No match is the healthy state and returns an
      # empty result, so noDataState must be OK — a missing host is scrape-target-down's
      # job, a failing lookup is vpn-egress-check-stale's.
      - uid: vpn-egress-isp-leak
        title: Traffic leaving on the home ISP instead of the VPN
        condition: C
        for: 5m
        noDataState: OK
        execErrState: Error
        labels:
          severity: critical
        annotations:
          summary: {% raw %}'{{ $labels.instance }} is no longer behind the VPN'{% endraw %}

          description: {% raw %}'Traffic from {{ $labels.instance }} is leaving on {{ $labels.ip }}, the same address as the home baseline, so the router VPN policy for its MAC is not in effect and the kill switch did not block it — check the policy on the Flint 2 and that the tunnel is up. Stop transmission there until it is fixed: `systemctl stop transmission` on lxc-media.'{% endraw %}

        data:
          - refId: A
            relativeTimeRange:
              from: 1800
              to: 0
            datasourceUid: Prometheus
            model:
              refId: A
              instant: true
              editorMode: code
              expr: 'max by (instance, ip) (max_over_time(vpn_egress_ip_info{side="protected"}[15m])) and on (ip) max by (ip) (max_over_time(vpn_egress_ip_info{side="baseline"}[15m]))'
          - refId: C
            datasourceUid: __expr__
            model:
              refId: C
              type: threshold
              expression: A
              conditions:
                - evaluator:
                    type: gt
                    params:
                      - 0

      # A check that cannot reach the lookup service proves nothing either way: on the
      # protected side a leak would go unseen, on the baseline side there is nothing to
      # compare against. With the router kill switch working, a dropped tunnel shows up
      # here (the protected lookup fails) rather than as a leak. Warning, not critical: the
      # usual cause is the service being briefly unreachable. The [15m] max bridges scrape
      # gaps, so a missing series is a real absence, not a blip.
      - uid: vpn-egress-check-stale
        title: VPN egress check has not succeeded
        condition: C
        for: 45m
        noDataState: NoData
        execErrState: Error
        labels:
          severity: warning
        annotations:
          summary: {% raw %}'Cannot confirm the VPN egress on {{ $labels.instance }}'{% endraw %}

          description: {% raw %}'The exit-address lookup on {{ $labels.instance }} ({{ $labels.side }} side) has been failing for 45 minutes, so a VPN leak on lxc-media would go unnoticed. On the protected side this is also what a dropped tunnel looks like with the router kill switch blocking traffic — check the tunnel on the Flint 2. Run `systemctl start vpn-egress-check` and read `journalctl -u vpn-egress-check`.'{% endraw %}

        data:
          - refId: A
            relativeTimeRange:
              from: 3600
              to: 0
            datasourceUid: Prometheus
            model:
              refId: A
              instant: true
              editorMode: code
              expr: 'max_over_time(vpn_egress_check_success[15m])'
          - refId: C
            datasourceUid: __expr__
            model:
              refId: C
              type: threshold
              expression: A
              conditions:
                - evaluator:
                    type: lt
                    params:
                      - 1

  - orgId: 1
    name: Backups
    folder: Homelab Alerts
    interval: 5m
    rules:
      # A failed backup is invisible until the day you need a restore. Both rules below
      # depend on node_exporter's systemd collector, which is scoped to the pbs-backup
      # units — see roles/node_exporter/templates/node-exporter.container.
      - uid: pbs-backup-failed
        title: PBS backup job failed
        condition: C
        for: 10m
        noDataState: NoData
        execErrState: Error
        labels:
          severity: warning
        annotations:
          summary: {% raw %}'PBS backup failed on {{ $labels.instance }}'{% endraw %}

          description: {% raw %}'pbs-backup.service is in the failed state on {{ $labels.instance }}. Run `journalctl -u pbs-backup.service` there; the usual causes are a full datastore or an expired backup-client@pbs password.'{% endraw %}

        data:
          - refId: A
            relativeTimeRange:
              from: 900
              to: 0
            datasourceUid: Prometheus
            model:
              refId: A
              instant: true
              editorMode: code
              expr: 'node_systemd_unit_state{name="pbs-backup.service", state="failed"}'
          - refId: C
            datasourceUid: __expr__
            model:
              refId: C
              type: threshold
              expression: A
              conditions:
                - evaluator:
                    type: gt
                    params:
                      - 0

      # Catches the quieter failure the rule above misses: the job never runs at all —
      # timer disabled, masked, or the host down at every trigger. The timer is daily, so
      # 36h is one missed run plus room for a late start.
      - uid: pbs-backup-stale
        title: PBS backup has not run in 36 hours
        condition: C
        for: 30m
        noDataState: NoData
        execErrState: Error
        labels:
          severity: warning
        annotations:
          summary: {% raw %}'No PBS backup on {{ $labels.instance }} for over 36h'{% endraw %}

          description: {% raw %}'pbs-backup.timer on {{ $labels.instance }} last fired {{ printf "%.1f" $values.A.Value }} hours ago. Check `systemctl list-timers pbs-backup.timer` on that host.'{% endraw %}

        data:
          - refId: A
            relativeTimeRange:
              from: 900
              to: 0
            datasourceUid: Prometheus
            model:
              refId: A
              instant: true
              editorMode: code
              expr: '(time() - node_systemd_timer_last_trigger_seconds{name="pbs-backup.timer"}) / 3600'
          - refId: C
            datasourceUid: __expr__
            model:
              refId: C
              type: threshold
              expression: A
              conditions:
                - evaluator:
                    type: gt
                    params:
                      - 36
