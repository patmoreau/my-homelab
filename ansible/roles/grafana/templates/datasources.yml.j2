apiVersion: 1

deleteDatasources:
  - name: Prometheus
    orgId: 1
  - name: Loki
    orgId: 1

datasources:
  - name: Prometheus
    uid: Prometheus
    type: prometheus
    # Since they are on the same machine (lxc-monitoring) but separate docker networks, use host IP or docker gateway. Let's use the lxc IP.
    url: http://{{ hostvars['lxc-monitoring']['ansible_host'] }}:9090
    access: proxy
    isDefault: true

  - name: Loki
    type: loki
    url: http://{{ hostvars['lxc-monitoring']['ansible_host'] }}:3100
    access: proxy