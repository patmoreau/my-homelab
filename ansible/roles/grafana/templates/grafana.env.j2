TZ={{ timezone }}
GF_SECURITY_ADMIN_USER={{ vault_grafana_admin_user }}
GF_SECURITY_ADMIN_PASSWORD={{ vault_grafana_admin_password }}
# Allow Homepage (home.moreaulab.ca) to embed /d-solo panels in iframes.
# Without this Grafana sends X-Frame-Options: deny and the panels render blank.
# Auth still required — the Grafana session cookie rides along because
# home.moreaulab.ca and grafana.moreaulab.ca share the same site.
GF_SECURITY_ALLOW_EMBEDDING=true

# Trust the identity oauth2-proxy established at the gateway, so the embedded panels
# render without a second Grafana login. GF_AUTH_PROXY_WHITELIST is the security control
# here: the header is trusted ONLY from lxc-gateway. Grafana also listens on :3000 on the
# LAN, where anyone could set X-Auth-Request-Email by hand — the whitelist is what stops
# that from being an instant admin session.
GF_AUTH_PROXY_ENABLED=true
GF_AUTH_PROXY_HEADER_NAME=X-Auth-Request-Email
GF_AUTH_PROXY_HEADER_PROPERTY=email
GF_AUTH_PROXY_AUTO_SIGN_UP=true
GF_AUTH_PROXY_HEADERS=Name:X-Auth-Request-Preferred-Username
GF_AUTH_PROXY_WHITELIST={{ hostvars['lxc-gateway']['ansible_host'] }}
# Only emails on the oauth2-proxy allowlist ever reach Grafana with this header.
GF_USERS_AUTO_ASSIGN_ORG_ROLE=Admin
# Grafana's own sign-out only drops Grafana's session; the next request still carries
# X-Auth-Request-Email from the SSO cookie and signs you straight back in. So sign-out
# has to walk the whole chain: Grafana session -> oauth2-proxy cookie -> Auth0 tenant
# session. Without the last hop the re-login is silent (Auth0 still has you logged in).
{% set auth0_logout = oauth2_proxy_issuer_url ~ 'v2/logout?client_id=' ~ vault_oauth2_proxy_client_id ~ '&returnTo=' ~ oauth2_proxy_logout_return_url %}
GF_AUTH_SIGNOUT_REDIRECT_URL=https://{{ oauth2_proxy_domain }}/oauth2/sign_out?rd={{ auth0_logout | urlencode }}
