[Unit]
Description=Holefeeder Web
After=holefeeder-api.service
BindsTo=holefeeder-postgres.service

[Container]
ContainerName=holefeeder_web
Image={{ holefeeder_registry }}/holefeeder-web:{{ holefeeder_image_tag }}
Label=io.containers.autoupdate=registry
Network=container:holefeeder_postgres

[Service]
Restart=always

[Install]
WantedBy=default.target
