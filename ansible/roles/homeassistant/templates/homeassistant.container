[Unit]
Description=Home Assistant

[Container]
ContainerName=homeassistant
Image=lscr.io/linuxserver/homeassistant:2026.6.1-ls219
# Host networking so device discovery (mDNS) and the IoT VLAN reach Home Assistant,
# exactly as under Docker.
Network=host
EnvironmentFile=/opt/docker/homeassistant/homeassistant.env
Volume=/data/config:/config
Volume=/etc/localtime:/etc/localtime:ro
# Runs 10-fix-cffi before Home Assistant starts (fixes the cffi upgrade race on this
# ephemeral container that breaks the wyzeapi integration).
Volume=/opt/docker/homeassistant/custom-cont-init.d:/custom-cont-init.d:ro

[Service]
Restart=always

[Install]
WantedBy=default.target
