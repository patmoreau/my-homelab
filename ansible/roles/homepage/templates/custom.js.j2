// Rotating space wallpaper. Rendered from templates/custom.js.j2 — the image pool is
// `homepage_background_images` in the role defaults, so the list of files that exist on
// disk and the list this script rotates through cannot drift apart.
//
// Homepage's `background:` setting takes one still URL and offers no rotation, and
// `custom.css` cannot read a clock, so the swap happens here. Homepage loads this file
// through /api/config/custom.js after hydration.
(() => {
  const IMAGES = [
{% for image in homepage_background_images %}
    '/images/space/{{ image.file }}', // {{ image.credit }}
{% endfor %}
  ];
  const PERIOD_MS = {{ homepage_background_rotate_hours }} * 60 * 60 * 1000;

  // Derived from the wall clock rather than from page load, so a browser opened just now
  // and one left running for a week show the same image, and it changes on the hour
  // boundary instead of drifting per tab.
  const currentImage = () => IMAGES[Math.floor(Date.now() / PERIOD_MS) % IMAGES.length];

  // Homepage renders `background-image: linear-gradient(<dim>, <dim>), url(<image>)` as
  // an inline style, the gradient being the `opacity:` from settings.yaml. Reuse
  // whatever it rendered instead of restating the value here, so changing `opacity:`
  // keeps working. The fallback matters only if that markup ever changes shape.
  const DEFAULT_DIM =
    'linear-gradient(rgb(var(--bg-color) / 0.5), rgb(var(--bg-color) / 0.5))';

  const dimLayer = (el) => {
    const inline = (el && el.style && el.style.backgroundImage) || '';
    const withoutUrl = inline.replace(/,?\s*url\((['"]?).*?\1\)\s*$/, '').trim();
    return withoutUrl.startsWith('linear-gradient') ? withoutUrl : DEFAULT_DIM;
  };

  // An injected stylesheet, not an inline style: `!important` is what lets it survive
  // every React re-render of #background without this script having to watch the DOM.
  const sheet = document.createElement('style');
  sheet.id = 'homelab-background-rotation';
  document.head.appendChild(sheet);

  let showing = null;

  const apply = () => {
    const image = currentImage();
    if (image === showing) return;

    const background = document.getElementById('background');
    if (!background) return; // pre-hydration; the interval below picks it up

    showing = image;
    sheet.textContent =
      `#background { background-image: ${dimLayer(background)}, url("${image}") !important; }`;
  };

  apply();
  // One minute is fine: the check is two comparisons, and it bounds how late a rotation
  // can land on a dashboard nobody has touched.
  setInterval(apply, 60 * 1000);
})();

// PR badge: open PRs, Renovate PRs and Renovate approvals, from service-watcher's
// /api/renovate (see tools/service-watcher). Shown two ways: a labelled pill in the header
// row, and "(open · renovate · approvals) Title" in the tab title so it reads from any other
// tab. Zeros stay in place so each position always means the same thing.
(() => {
  const STATUS_URL = '{{ homepage_renovate_status_url }}';
  const POLL_MS = 10 * 60 * 1000;
  const COUNT_PREFIX = /^\(\d+ · \d+ · \d+\)\s*/;
  const PILL_ID = 'renovate-badge';

  let counts = null; // { open, renovate, approvals } once the first poll lands

  const values = () => {
    if (!counts) return null;
    const list = [counts.open, counts.renovate, counts.approvals];
    return list.every((n) => typeof n === 'number') ? list : null;
  };

  // Homepage's Next.js head manager rewrites document.title on re-render, which drops the
  // count. So the count is re-applied on top of whatever name is current.
  const syncTitle = () => {
    const name = document.title.replace(COUNT_PREFIX, '');
    const list = values();
    const want = list && list.some((n) => n > 0) ? `(${list.join(' · ')}) ${name}` : name;
    if (document.title !== want) document.title = want;
  };

  // Homepage re-renders the header row, which drops anything injected into it. So the pill
  // is checked on every change and put back when it is missing.
  const syncPill = () => {
    const row = document.getElementById('information-widgets');
    const list = values();
    if (!row || !list) return;

    let pill = document.getElementById(PILL_ID);
    if (!pill) {
      pill = document.createElement('div');
      pill.id = PILL_ID;
      pill.style.cssText =
        'align-self:center;margin:0.5rem;padding:0.4rem 0.8rem;border-radius:0.5rem;' +
        'font-size:0.9rem;background:rgb(var(--bg-color) / 0.6);';
      row.prepend(pill);
    }
    const text = `PRs ${list[0]} · Renovate ${list[1]} · Approvals ${list[2]}`;
    if (pill.textContent !== text) pill.textContent = text;
  };

  // Writes are guarded by comparison, so the observer's own changes settle instead of looping.
  const refresh = () => {
    syncTitle();
    syncPill();
  };

  new MutationObserver(refresh).observe(document.documentElement, {
    childList: true,
    subtree: true,
    characterData: true,
  });

  const poll = async () => {
    try {
      const res = await fetch(STATUS_URL);
      // Service-watcher unreachable or erroring: keep the last counts rather than flashing zeros.
      if (!res.ok) return;
      const { open, renovate, approvals } = await res.json();
      counts = { open, renovate, approvals };
      refresh();
    } catch {
      // Network failure: same as above.
    }
  };

  refresh();
  poll();
  setInterval(poll, POLL_MS);
})();
