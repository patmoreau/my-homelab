[Unit]
Description=Homepage dashboard

[Container]
ContainerName=homepage
Image=ghcr.io/gethomepage/homepage:v2.2.0
# Host networking rather than a published port on the bridge. The pinned-IP approach used
# elsewhere works around netavark leaving a stale port-DNAT rule on recreate, but it trades
# that for a worse failure: podman 4.9 can also leak the old container's netns, and because
# the replacement reuses the pinned address the corpse keeps answering ARP for it. The host
# then reaches the dead netns and every connection to :3000 is refused while the container
# itself is perfectly healthy - twice here, hence the move. Host networking has no DNAT hop
# and no veth, so neither leak can happen. Homepage binds :3000 directly on lxc-tools, which
# is the address Traefik and the blackbox probe already target, so nothing downstream changes.
Network=host
Volume=/opt/docker/homepage/config:/app/config
Volume=/opt/docker/homepage/config/logs:/app/config/logs
# /api/config only serves custom.css and custom.js, so a local wallpaper has to go in
# Homepage's own public dir, where it is served as /images/<name>. Shadows a stray
# solisquad.svg shipped in the image that nothing references.
Volume=/opt/docker/homepage/images:/app/public/images
# Secrets/vars are rendered separately (Renovate keeps this plain file's Image tag bumped).
EnvironmentFile=/opt/docker/homepage/homepage.env

[Service]
Restart=always

[Install]
WantedBy=default.target
