# Shared by all four immich containers (they run in one network namespace, so the
# server reaches postgres/redis/ml over 127.0.0.1). Extra vars are harmless per container.
DB_HOSTNAME=127.0.0.1
DB_USERNAME={{ vault_immich_db_username }}
DB_PASSWORD={{ vault_immich_db_password }}
DB_DATABASE_NAME={{ vault_immich_db_name }}
REDIS_HOSTNAME=127.0.0.1
IMMICH_MACHINE_LEARNING_URL=http://127.0.0.1:3003
POSTGRES_USER={{ vault_immich_db_username }}
POSTGRES_PASSWORD={{ vault_immich_db_password }}
POSTGRES_DB={{ vault_immich_db_name }}
POSTGRES_INITDB_ARGS=--data-checksums
IMMICH_MACHINE_LEARNING_GPU_TYPE=vaapi
DEVICE_NAME=/dev/dri/renderD128
