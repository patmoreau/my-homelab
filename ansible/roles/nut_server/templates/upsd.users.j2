# {{ ansible_managed }}
# Local upsmon on this host — drives the graceful shutdown (primary).
[upsmon]
    password = {{ vault_nut_admin_password }}
    upsmon primary

# Read-only monitor used by Home Assistant's NUT integration.
[homeassistant]
    password = {{ vault_nut_monitor_password }}
    upsmon secondary

{% if nut_qnap_slave %}
# QNAP network UPS slave (IP-only QTS mode). QNAP hardcodes this user/password and
# the UPS name "qnapups" (see the dummy-ups repeater in ups.conf) — none are editable
# in QTS. Read-only (secondary); cannot control the UPS. "123456" is QNAP's public
# default, not a secret, so it is intentionally not vaulted.
[admin]
    password = 123456
    upsmon secondary
{% endif %}
