OAUTH2_PROXY_PROVIDER=oidc
OAUTH2_PROXY_PROVIDER_DISPLAY_NAME=Auth0
OAUTH2_PROXY_OIDC_ISSUER_URL={{ oauth2_proxy_issuer_url }}
OAUTH2_PROXY_CLIENT_ID={{ vault_oauth2_proxy_client_id }}
OAUTH2_PROXY_CLIENT_SECRET={{ vault_oauth2_proxy_client_secret }}
OAUTH2_PROXY_COOKIE_SECRET={{ vault_oauth2_proxy_cookie_secret }}
OAUTH2_PROXY_REDIRECT_URL=https://{{ oauth2_proxy_domain }}/oauth2/callback

OAUTH2_PROXY_HTTP_ADDRESS=0.0.0.0:{{ oauth2_proxy_port }}
# Trust Traefik's X-Forwarded-* headers; without it every forwardAuth call is judged
# against the proxy's own host instead of the router's and the redirect loops.
OAUTH2_PROXY_REVERSE_PROXY=true
# No real backend — this instance only answers /oauth2/* and the forwardAuth probe.
OAUTH2_PROXY_UPSTREAMS=static://202
# Hands X-Auth-Request-User / -Email back to Traefik, which forwards them to Grafana.
OAUTH2_PROXY_SET_XAUTHREQUEST=true
OAUTH2_PROXY_PASS_ACCESS_TOKEN=false
OAUTH2_PROXY_SKIP_PROVIDER_BUTTON=true

# One cookie for the whole site, so authenticating at home.moreaulab.ca also covers the
# grafana.moreaulab.ca iframes it embeds. Same-site, so SameSite=lax still sends it.
OAUTH2_PROXY_COOKIE_DOMAINS={{ oauth2_proxy_cookie_domain }}
# The Auth0 host is whitelisted alongside the site so that sign-out can hand off to the
# tenant's /v2/logout. An `rd=` target outside this list is silently dropped, which looks
# exactly like a logout that did nothing.
OAUTH2_PROXY_WHITELIST_DOMAINS={{ oauth2_proxy_cookie_domain }},{{ oauth2_proxy_issuer_url | urlsplit('hostname') }}
OAUTH2_PROXY_COOKIE_SECURE=true
OAUTH2_PROXY_COOKIE_SAMESITE=lax
OAUTH2_PROXY_COOKIE_EXPIRE={{ oauth2_proxy_cookie_expire }}
OAUTH2_PROXY_COOKIE_REFRESH={{ oauth2_proxy_cookie_refresh }}
# offline_access is what makes Auth0 hand back a refresh token; the Auth0 application
# also needs the Refresh Token grant enabled or the scope is granted and no token comes.
OAUTH2_PROXY_SCOPE={{ oauth2_proxy_scope }}
OAUTH2_PROXY_SESSION_STORE_TYPE=cookie

# Auth0 authenticates; this file authorises. EMAIL_DOMAINS=* would let in every account
# the tenant has, so the allowlist is what actually gates the homelab.
OAUTH2_PROXY_EMAIL_DOMAINS=*
OAUTH2_PROXY_AUTHENTICATED_EMAILS_FILE=/etc/oauth2-proxy/authenticated-emails
