# Shared by every Penpot container. Inter-container URIs use 127.0.0.1 because the
# containers share the postgres container's network namespace (no DNS between them).
PENPOT_PUBLIC_URI=https://penpot.moreaulab.ca
PENPOT_SECRET_KEY={{ vault_penpot_secret_key }}
PENPOT_FLAGS=enable-smtp enable-prepl-server enable-admin-console enable-mcp disable-registration

PENPOT_DATABASE_URI=postgresql://127.0.0.1/penpot
PENPOT_DATABASE_USERNAME=penpot
PENPOT_DATABASE_PASSWORD={{ vault_penpot_postgres_password }}
POSTGRES_DB=penpot
POSTGRES_USER=penpot
POSTGRES_PASSWORD={{ vault_penpot_postgres_password }}

PENPOT_REDIS_URI=redis://127.0.0.1/0
PENPOT_OBJECTS_STORAGE_BACKEND=fs
PENPOT_OBJECTS_STORAGE_FS_DIRECTORY=/opt/data/objects

PENPOT_BACKEND_URI=http://127.0.0.1:6060
PENPOT_EXPORTER_URI=http://127.0.0.1:6061
PENPOT_INTERNAL_URI=http://127.0.0.1:8080

PENPOT_HTTP_SERVER_MAX_BODY_SIZE=367001600
PENPOT_HTTP_SERVER_MAX_MULTIPART_BODY_SIZE=367001600

# Resend, same account as essere. Sender domain moreaulab.ca is verified there.
PENPOT_SMTP_HOST=smtp.resend.com
PENPOT_SMTP_PORT=587
PENPOT_SMTP_USERNAME=resend
PENPOT_SMTP_PASSWORD={{ vault_mail_api_key }}
PENPOT_SMTP_TLS=true
PENPOT_SMTP_DEFAULT_FROM=Penpot <penpot@moreaulab.ca>
PENPOT_SMTP_DEFAULT_REPLY_TO=Penpot <penpot@moreaulab.ca>
