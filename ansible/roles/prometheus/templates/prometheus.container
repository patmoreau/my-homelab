[Unit]
Description=Prometheus

[Container]
ContainerName=prometheus
Image=prom/prometheus:v3.13.2
PublishPort=9090:9090
Volume=/opt/docker/prometheus/config:/etc/prometheus-config:ro
Volume=/data/prometheus:/prometheus
Exec=--config.file=/etc/prometheus-config/prometheus.yml --storage.tsdb.path=/prometheus --storage.tsdb.retention.time=15d --storage.tsdb.retention.size=6GB --web.console.libraries=/etc/prometheus/console_libraries --web.console.templates=/etc/prometheus/consoles --web.enable-lifecycle

[Service]
Restart=always

[Install]
WantedBy=default.target
