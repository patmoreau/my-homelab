global:
  scrape_interval: 15s
  evaluation_interval: 15s

scrape_configs:
  - job_name: 'prometheus'
    static_configs:
      - targets: ['localhost:9090']
        labels:
          instance: 'lxc-monitoring'

  - job_name: 'node_exporter'
    static_configs:
{% for host in groups['lxc'] %}
      - targets: ['{{ hostvars[host]['ansible_host'] }}:9100']
        labels:
          container_name: '{{ host }}'
{% endfor %}
    relabel_configs:
      - source_labels: [container_name]
        target_label: instance

  - job_name: 'cadvisor'
    static_configs:
{% for host in groups['lxc'] if host != 'lxc-pbs' %}
      - targets: ['{{ hostvars[host]['ansible_host'] }}:9338']
        labels:
          container_name: '{{ host }}'
{% endfor %}
    relabel_configs:
      - source_labels: [container_name]
        target_label: instance

  - job_name: 'service_watcher'
    static_configs:
      - targets:
          - '{{ hostvars['lxc-media']['ansible_host'] }}:{{ hostvars['lxc-media'].get('service_watcher_port', 3000) }}'

  - job_name: 'blackbox'
    metrics_path: /probe
    params:
      module: [http_2xx]
    static_configs:
      - targets: ['http://{{ hostvars["lxc-vault"]["ansible_host"] }}:8080/alive']
        labels:
          service: 'vaultwarden'
      - targets: ['http://{{ hostvars["lxc-essere"]["ansible_host"] }}:3000']
        labels:
          service: 'essere-app'
      - targets: ['http://{{ hostvars["lxc-essere"]["ansible_host"] }}:8055/server/health']
        labels:
          service: 'essere-directus'
      - targets: ['http://{{ hostvars["lxc-media"]["ansible_host"] }}:3001/api/v1/health']
        labels:
          service: 'book-orbit'
      - targets: ['http://{{ hostvars["lxc-media"]["ansible_host"] }}:8096']
        labels:
          service: 'jellyfin'
      - targets: ['http://{{ hostvars["lxc-immich"]["ansible_host"] }}:2283/api/server/ping']
        labels:
          service: 'immich'
      - targets: ['http://{{ hostvars["lxc-homeassistant"]["ansible_host"] }}:8123']
        labels:
          service: 'homeassistant'
      - targets: ['http://{{ hostvars["lxc-tools"]["ansible_host"] }}:3000']
        labels:
          service: 'homepage'
      - targets: ['http://{{ hostvars["lxc-essere"]["ansible_host"] }}:{{ hostvars["lxc-essere"].get("umami_port", 3001) }}']
        labels:
          service: 'umami'
    relabel_configs:
      - source_labels: [__address__]
        target_label: __param_target
      - source_labels: [__param_target]
        target_label: instance
      - target_label: __address__
        replacement: '{{ hostvars["lxc-monitoring"]["ansible_host"] }}:9115'

  # The 'blackbox' job above hits containers on their LAN IP, so it only proves the app
  # is alive. These probe the real public URLs, which exercises the whole chain —
  # Cloudflare, the tunnel, Traefik routing and the TLS cert. A green internal probe with
  # a red public one means the site is down for visitors even though the app is fine.
  - job_name: 'blackbox_public'
    metrics_path: /probe
    params:
      module: [http_2xx]
    static_configs:
      - targets: ['https://essere.ca']
        labels:
          service: 'essere-public'
      - targets: ['https://admin.essere.ca']
        labels:
          service: 'essere-admin-public'
    relabel_configs:
      - source_labels: [__address__]
        target_label: __param_target
      - source_labels: [__param_target]
        target_label: instance
      - target_label: __address__
        replacement: '{{ hostvars["lxc-monitoring"]["ansible_host"] }}:9115'

  - job_name: 'traefik'
    static_configs:
      - targets: ['{{ hostvars["lxc-gateway"]["ansible_host"] }}:8082']
        labels:
          instance: 'lxc-gateway'

  - job_name: 'pve'
    static_configs:
      - targets:
{% for host in groups['hypervisors'] %}
          - '{{ hostvars[host]['ansible_host'] }}'
{% endfor %}
    metrics_path: /pve
    params:
      module: [default]
    relabel_configs:
      - source_labels: [__address__]
        target_label: __param_target
      - source_labels: [__param_target]
        target_label: instance
      - target_label: __address__
        replacement: '{{ hostvars["lxc-monitoring"]["ansible_host"] }}:9221'
