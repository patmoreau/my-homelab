global:
  scrape_interval: 15s
  evaluation_interval: 15s

scrape_configs:
  - job_name: 'prometheus'
    static_configs:
      - targets: ['localhost:9090']

  - job_name: 'node_exporter'
    static_configs:
      - targets:
{% for host in groups['lxc'] %}
          - '{{ hostvars[host]['ansible_host'] }}:9100'
{% endfor %}

  - job_name: 'cadvisor'
    static_configs:
      - targets:
{% for host in groups['lxc'] %}
          - '{{ hostvars[host]['ansible_host'] }}:9338'
{% endfor %}

  - job_name: 'service_watcher'
    static_configs:
      - targets:
          - '{{ hostvars['lxc-media']['ansible_host'] }}:{{ hostvars['lxc-media'].get('service_watcher_port', 3000) }}'
