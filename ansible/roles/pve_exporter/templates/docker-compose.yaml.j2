services:
  pve_exporter:
    image: prompve/prometheus-pve-exporter:latest
    container_name: pve_exporter
    restart: unless-stopped
    ports:
      - 9221:9221
    networks:
      - monitoring_shared
    volumes:
      - ./pve.yml:/etc/prometheus/pve.yml:ro
    command:
      - '--config.file=/etc/prometheus/pve.yml'

networks:
  monitoring_shared:
    name: monitoring_shared
    external: true
