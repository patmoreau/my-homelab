[Unit]
Description=Sonarr
After=transmission.service

[Container]
ContainerName=sonarr
Image=lscr.io/linuxserver/sonarr:5.14
IP=10.88.0.248
PublishPort=8989:8989
EnvironmentFile=/opt/docker/sonarr/sonarr.env
# One mount of the whole NAS share — binding /media/tv and /media/downloads separately
# would put them on different mounts and link() across mount points fails with EXDEV, so
# every import would silently copy instead of hardlink. See the radarr role.
Volume=/data/sonarr:/config
Volume=/media:/media
# Prowlarr pushes indexers in over the API and Sonarr answers on its own hostname; the
# router will not resolve a moreaulab.ca name to a private address, so map it here.
PodmanArgs=--add-host prowlarr.moreaulab.ca:10.88.0.247

[Service]
Restart=always

[Install]
WantedBy=default.target
