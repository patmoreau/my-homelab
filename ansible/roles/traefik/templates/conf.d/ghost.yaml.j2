http:
  middlewares:
    ghost-https:
      headers:
        customRequestHeaders:
          X-Forwarded-Proto: "https"

  routers:
    ghost:
      rule: "Host(`ghost.moreaulab.ca`)"
      entryPoints:
        - web
      middlewares:
        - ghost-https
      service: ghost

  services:
    ghost:
      loadBalancer:
        servers:
          - url: "http://{{ hostvars['lxc-essere']['ansible_host'] }}:2368"
