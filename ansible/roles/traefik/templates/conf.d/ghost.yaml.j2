http:
  routers:
    ghost:
      rule: "Host(`ghost.moreaulab.ca`)"
      entryPoints:
        - websecure
      tls:
        certResolver: cloudflare
      service: ghost

  services:
    ghost:
      loadBalancer:
        servers:
          - url: "http://{{ hostvars['lxc-essere']['ansible_host'] }}:2368"
