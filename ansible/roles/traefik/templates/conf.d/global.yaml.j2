http:
  serversTransports:
    insecure-transport:
      insecureSkipVerify: true

  middlewares:
    # Proxy/trust headers only. We intentionally do NOT set response security
    # headers here (frameDeny, STS, nosniff, XSS): the backend apps
    # (Vaultwarden, Immich, Grafana, Jellyfin) set their own, and forcing
    # frameDeny: DENY here clobbered Vaultwarden's X-Frame-Options: SAMEORIGIN
    # and broke its same-origin-iframe web vault.
    global-headers:
      headers:
        customRequestHeaders:
          X-Forwarded-Proto: "https"
          X-Forwarded-Ssl: "on"
          X-Forwarded-Port: "443"
        sslProxyHeaders:
          X-Forwarded-Proto: "https"
