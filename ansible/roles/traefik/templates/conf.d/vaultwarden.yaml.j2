http:
  routers:
    vaultwarden:
      rule: "Host(`vault.moreaulab.ca`)"
      entryPoints:
        - websecure
      tls:
        certResolver: cloudflare
      service: vaultwarden

  services:
    vaultwarden:
      loadBalancer:
        servers:
          - url: "http://{{ hostvars['lxc-vault']['ansible_host'] }}:8080"
