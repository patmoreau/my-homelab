services:
  traefik:
    image: traefik:v3.6.11
    container_name: traefik
    restart: unless-stopped
    security_opt:
      - no-new-privileges:true
    ports:
      - 80:80
      - 443:443
      - 8080:8080
    networks:
      - gateway
    environment:
      - CF_DNS_API_TOKEN=${CF_DNS_API_TOKEN}
    volumes:
      - ./traefik.yaml:/etc/traefik/traefik.yaml:ro
      - ./conf.d:/etc/traefik/conf.d:ro
      - ./acme.json:/etc/traefik/acme.json
      - certs:/etc/traefik/certs

  certs-dumper:
    image: ldez/traefik-certs-dumper:v2.8.3
    container_name: traefik-certs-dumper
    restart: unless-stopped
    environment:
      - PVE_API_TOKEN=${PVE_API_TOKEN}
    entrypoint: |
      sh -c '
        apk add --no-cache inotify-tools openssh-client curl &&
        PBS_DIR="/etc/traefik/certs/{{ pbs_domain }}" &&
        PVE_DIR="/etc/traefik/certs/{{ proxmox_domain }}" &&
        PBS_LAST_HASH="" &&
        PVE_LAST_HASH="" &&
        deploy_to_pbs() {
          if [ ! -d "$$PBS_DIR" ]; then return 0; fi
          HASH=$$(md5sum "$$PBS_DIR/certificate.crt" 2>/dev/null || echo "") &&
          if [ "$$HASH" = "$$PBS_LAST_HASH" ]; then
            echo "[certs-dumper] PBS cert unchanged, skipping deploy"
            return 0
          fi &&
          echo "[certs-dumper] Deploying cert to PBS..." &&
          ssh -i /root/.ssh/deploy_key \
            -o StrictHostKeyChecking=no \
            -o ConnectTimeout=10 \
            root@{{ hostvars["lxc-pbs"]["ansible_host"] }} \
            "cat > /etc/proxmox-backup/proxy.pem" \
            < "$$PBS_DIR/certificate.crt" &&
          ssh -i /root/.ssh/deploy_key \
            -o StrictHostKeyChecking=no \
            -o ConnectTimeout=10 \
            root@{{ hostvars["lxc-pbs"]["ansible_host"] }} \
            "cat > /etc/proxmox-backup/proxy.key" \
            < "$$PBS_DIR/privatekey.key" &&
          ssh -i /root/.ssh/deploy_key \
            -o StrictHostKeyChecking=no \
            -o ConnectTimeout=10 \
            root@{{ hostvars["lxc-pbs"]["ansible_host"] }} \
            "systemctl restart proxmox-backup-proxy" &&
          PBS_LAST_HASH="$$HASH" &&
          echo "[certs-dumper] PBS cert deployed successfully"
        } &&
        deploy_to_pve() {
          if [ ! -d "$$PVE_DIR" ]; then return 0; fi
          HASH=$$(md5sum "$$PVE_DIR/certificate.crt" 2>/dev/null || echo "") &&
          if [ "$$HASH" = "$$PVE_LAST_HASH" ]; then
            echo "[certs-dumper] PVE cert unchanged, skipping deploy"
            return 0
          fi &&
          echo "[certs-dumper] Deploying cert to PVE via API..." &&
          curl -s -k -X POST "https://{{ hostvars['pve-homelab']['ansible_host'] }}:8006/api2/json/nodes/{{ proxmox_node }}/certificates/custom" \
            -H "Authorization: PVEAPIToken=$$PVE_API_TOKEN" \
            --data-urlencode "certificates=$$(cat $$PVE_DIR/certificate.crt)" \
            --data-urlencode "key=$$(cat $$PVE_DIR/privatekey.key)" \
            --data "restart=1" &&
          PVE_LAST_HASH="$$HASH" &&
          echo "[certs-dumper] PVE cert deployed successfully"
        } &&
        while true; do
          traefik-certs-dumper file \
            --version v2 \
            --source /etc/traefik/acme.json \
            --dest /etc/traefik/certs \
            --domain-subdir &&
          deploy_to_pbs || echo "[certs-dumper] PBS SSH deploy failed"
          deploy_to_pve || echo "[certs-dumper] PVE API deploy failed"
          inotifywait -e modify /etc/traefik/acme.json
        done
      '
    volumes:
      - ./acme.json:/etc/traefik/acme.json:ro
      - certs:/etc/traefik/certs
      - ./certs-dumper-key:/root/.ssh/deploy_key:ro

volumes:
  certs:

networks:
  gateway:
    external: true
