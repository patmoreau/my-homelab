[Unit]
Description=Transmission

[Container]
ContainerName=transmission
Image=lscr.io/linuxserver/transmission:4.1.3-r0-ls362
IP=10.88.0.242
PublishPort=9091:9091
PublishPort=51413:51413
PublishPort=51413:51413/udp
EnvironmentFile=/opt/docker/transmission/transmission.env
Volume=/data/transmission/config:/config
Volume=/media/downloads/complete:/downloads/complete
# Incomplete on the local NVMe volume, not the NAS export. The in-progress writes are what
# broke this: a stuck NFS COMMIT on a .part file left the disk thread in D state and the RPC
# unreachable while the container looked healthy. Completion moves the finished file to
# /downloads/complete on the NAS, which is a copy across mounts rather than a rename — the
# one cost of splitting them, and cheaper than the stall it avoids.
Volume=/downloads/incomplete:/downloads/incomplete

[Service]
Restart=always

[Install]
WantedBy=default.target
