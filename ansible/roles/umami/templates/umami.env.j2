DATABASE_TYPE=postgresql
DATABASE_URL=postgresql://{{ postgres_user }}:{{ postgres_password }}@{{ umami_db_host }}:5432/{{ umami_db_name }}
APP_SECRET={{ umami_app_secret }}
# Umami sits behind Traefik, which sits behind the Cloudflare tunnel. Without this the
# client IP recorded for every hit is the proxy's, so every visitor geolocates to the
# same place.
CLIENT_IP_HEADER=CF-Connecting-IP
TRACKER_SCRIPT_NAME=script.js
